# Local build-time secrets, read by build.rs. Copy to `.env` (git-ignored) and fill in.
# In CI the same variables come from GitHub Actions secrets, not this file.

# Sentry DSN for the "Report a problem" feature. Without it the report can only be saved
# locally (the "Send" button becomes "Save") and nothing is sent to Sentry. It is a public,
# write-only ingest key.
SENTRY_DSN=
